# Disposable localhost demo values. Copy to .env and replace them before any
# shared-host, remote-bind, or non-demo deployment.
AGENTOPS_DATABASE_URL=sqlite+pysqlite:///./data/agentops.db
# Compose passes this as a separate component and the app URL-encodes it.
AGENTOPS_POSTGRES_PASSWORD=agentops-local
AGENTOPS_API_KEYS=demo-key=demo-admin:admin
# Set this to an available localhost port; keep browser origins on the same port.
AGENTOPS_HOST_PORT=8000
# Generate a private HMAC key with: python -m agentops.local_config
# Empty signing configuration disables browser sessions outside Compose.
AGENTOPS_SESSION_SECRET=
AGENTOPS_SESSION_COOKIE_SECURE=false
# For an explicitly configured HTTPS deployment, replace with the canonical origin.
AGENTOPS_BROWSER_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AGENTOPS_LLM_PROVIDER=fake
AGENTOPS_LLM_PROTOCOL=responses
AGENTOPS_LLM_MODEL=fake-deterministic
# Compose explicitly selects postgres and runs its separate checkpoint migration.
# Outside Compose, omit both settings for memory, or use sqlite plus a NEW path.
# AGENTOPS_CHECKPOINT_BACKEND=postgres
# AGENTOPS_CHECKPOINT_PATH=./data/new-checkpoints.sqlite
# Optional outside Compose: route one graph status read through local stdio MCP.
# AGENTOPS_MCP_READ_TOOL=get_service_status
# Set these only for an explicitly configured external provider run:
# AGENTOPS_LLM_API_KEY=
# AGENTOPS_LLM_BASE_URL=
# Local Ollama only: explicit thinking profile, with separately bounded budgets.
# AGENTOPS_LLM_THINK=false
# AGENTOPS_LLM_TEMPERATURE=1.0
# AGENTOPS_LLM_NUM_CTX=16384
# AGENTOPS_LLM_NUM_PREDICT=2048
# AGENTOPS_REDIS_URL=redis://localhost:6379/0
# AGENTOPS_REDIS_QUEUE=agentops.commands
# AGENTOPS_CELERY_TASK_NAME=agentops.execute_command
# AGENTOPS_BROKER_PUBLISH_TIMEOUT_SECONDS=5
